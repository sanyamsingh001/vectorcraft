  "title": "Fix #525: Image Trace of a large photo no longer crashes the app",
  "user": {
    "login": "bflatastic",
    "id": 46063141,
    "node_id": "MDQ6VXNlcjQ2MDYzMTQx",
    "avatar_url": "https://avatars.githubusercontent.com/u/46063141?v=4",
    "gravatar_id": "",
    "url": "https://api.github.com/users/bflatastic",
    "html_url": "https://github.com/bflatastic",
    "followers_url": "https://api.github.com/users/bflatastic/followers",
    "following_url": "https://api.github.com/users/bflatastic/following{/other_user}",
    "gists_url": "https://api.github.com/users/bflatastic/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/bflatastic/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/bflatastic/subscriptions",
    "organizations_url": "https://api.github.com/users/bflatastic/orgs",
    "repos_url": "https://api.github.com/users/bflatastic/repos",
    "events_url": "https://api.github.com/users/bflatastic/events{/privacy}",
