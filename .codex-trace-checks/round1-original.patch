+/// #543: both Object > Image Trace dialogs list the engine's registered presets, and OK
+/// traces with the selected canonical name (or expands it), in one undoable edit.
+#[test]
+fn image_trace_make_dialogs_list_registered_presets_and_apply_the_choice() {
+    use vectorcraft_doc::NodeKind;
+    for (command, initial, expanded) in [("imageTrace.make", "Black and White Logo", false), ("imageTrace.makeAndExpand", "6 Colors", true)] {
+        let (ctx, mut app) = (ctx(), app_with_selection());
+        let raster = image::RgbaImage::from_fn(32, 32, |x, y| image::Rgba([(x * 8) as u8, (y * 8) as u8, 128, 255]));
+        let mut png = std::io::Cursor::new(Vec::new());
+        raster.write_to(&mut png, image::ImageFormat::Png).unwrap();
+        let data = vectorcraft_format::base64_encode(png.get_ref());
+        app.run("file.place", json!({"name": "synthetic.png", "dataBase64": data, "link": false})).unwrap();
+        let image_id = app.session.doc().unwrap().selection.objects[0];
+        let registry = app.run("imageTrace.presets", json!({})).unwrap();
+        let names: Vec<&str> = registry["presets"].as_array().unwrap().iter().map(|p| p["name"].as_str().unwrap()).collect();
+        let menu = crate::menus::menu_entries(&app).into_iter().find(|e| e.command.as_deref() == Some(command)).unwrap();
+        assert_eq!(menu.params["preset"], initial);
+        let (id, params) = crate::menus::click_target(&menu.label, command, &menu.params);
+        crate::menus::invoke(&mut app, &id, params);
+        settle(&ctx, &mut app);
+        let texts = frame(&ctx, &mut app, vec![]);
+        let at = |texts: &[(String, Rect)], label: &str| texts.iter().find(|(t, _)| t == label).unwrap().1.center();
+        let open = click(&ctx, &mut app, at(&texts, initial));
+        // The established combo scrolls a long list. Verify all entries by scrolling it,
+        // then return to the top to choose the larger palette.
+        let pointer = at(&open, "Default");
+        let mut listed = open;
+        let scroll = |delta| {
+            vec![
+                Event::PointerMoved(pointer),
+                Event::MouseWheel { unit: egui::MouseWheelUnit::Point, delta: vec2(0.0, delta), modifiers: Default::default() },
+            ]
+        };
+        frame(&ctx, &mut app, scroll(-400.0));
+        settle(&ctx, &mut app);
+        listed.extend(frame(&ctx, &mut app, vec![]));
+        for name in &names {
+            assert!(listed.iter().any(|(t, _)| t == name), "{command}: {name} missing from {listed:?}");
+        }
+        frame(&ctx, &mut app, scroll(400.0));
+        settle(&ctx, &mut app);
+        let open = frame(&ctx, &mut app, vec![]);
+        click(&ctx, &mut app, at(&open, "16 Colors"));
+        assert_eq!(app.ui.dialog.as_ref().unwrap().str("preset"), "16 Colors");
+        let result = confirm(&mut app).unwrap();
+        assert!(result["colors"].as_u64().unwrap() > 6, "selected the larger palette");
+        let st = app.session.doc().unwrap();
+        let group = st.doc.node(st.selection.objects[0]).unwrap();
+        if expanded {
+            assert!(group.trace.is_none());
+            assert!(group.children().unwrap().iter().all(|n| !matches!(n.kind, NodeKind::Image(_))));
+        } else {
+            assert_eq!(group.trace.as_ref().unwrap()["preset"], "16 Colors");
+            assert_eq!(group.trace.as_ref().unwrap()["params"]["colors"], 16);
+        }
+        app.run("edit.undo", json!({})).unwrap();
+        let st = app.session.doc().unwrap();
+        assert_eq!(st.selection.objects, vec![image_id]);
+        assert!(matches!(st.doc.node(image_id).unwrap().kind, NodeKind::Image(_)));
+    }
+}
