+    // 99,856 paths exceed the document output limit, not the per-layer working set.
+    let img = Raster::from_fn(316, 316, |x, y| if (x + y) % 2 == 0 { BLACK } else { WHITE });
+    assert!(matches!(trace(&img, &TraceParams { noise: 0, ..TraceParams::default() }), Err(TraceError::ResourceLimit { resource: "path", .. })));
+}
