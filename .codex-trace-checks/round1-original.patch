+
+#[test]
+fn image_trace_resource_failure_preserves_document_selection_and_undo() {
+    for command in ["imageTrace.make", "imageTrace.makeAndExpand"] {
+        let mut s = session();
+        let raster = vectorcraft_trace::Raster::from_fn(450, 450, |x, y| if (x + y) % 2 == 0 { [0, 0, 0, 255] } else { [255, 255, 255, 255] });
+        let image = add_image(&mut s, &raster, Affine::IDENTITY);
+        let before = vectorcraft_format::save(&s.doc().unwrap().doc, false);
+        let err = s.execute(command, &json!({"preset": "Black and White Logo", "params": {"noise": 0}})).unwrap_err();
+        assert!(err.to_string().contains("component working set limit"), "{err}");
+        assert_eq!(vectorcraft_format::save(&s.doc().unwrap().doc, false), before);
+        assert_eq!(s.doc().unwrap().selection.objects, vec![image]);
+        // No trace undo entry was created; the previous image insertion is what Undo removes.
+        s.execute("edit.undo", &json!({})).unwrap();
+        assert!(s.doc().unwrap().doc.node(image).is_none());
+    }
+}
