 /// Trace every component of `mask` (row-major, `w × h`).
 pub fn trace_mask(mask: &[bool], w: usize, h: usize) -> Vec<Component> {
     assert_eq!(mask.len(), w * h);
+    // Overlapping traces start with a solid bottom layer. Its contour is exact and
+    // needs no pixel-sized component table, flood stack or edge grid.
+    if let Some(&inside) = mask.first()
+        && mask.iter().all(|&m| m == inside)
+    {
+        return if inside {
+            vec![Component {
+                outer: Loop { pts: vec![(0, 0), (w as i32, 0), (w as i32, h as i32), (0, h as i32)], area2: 2 * (w * h) as i64 },
+                holes: Vec::new(),
+                pixels: w * h,
+            }]
+        } else {
+            Vec::new()
+        };
+    }
+    collect_contours(mask, w, h)
+}
