+
+    /// The flood fill before the optimizations, for exact label-for-label parity.
+    fn reference(labels: &mut [u16], w: usize, h: usize, min_area: usize) {
+        if min_area <= 1 || w == 0 || h == 0 {
+            return;
+        }
+        let mut seen = vec![false; w * h];
+        let mut stack: Vec<usize> = Vec::new();
+        let mut comp: Vec<usize> = Vec::new();
+        let mut neigh: Vec<(u16, u32)> = Vec::new();
+        for start in 0..w * h {
+            if seen[start] || labels[start] == TRANSPARENT {
+                continue;
+            }
+            let l = labels[start];
+            comp.clear();
+            neigh.clear();
+            stack.push(start);
+            seen[start] = true;
+            let mut small = true;
+            while let Some(i) = stack.pop() {
+                if small {
+                    comp.push(i);
+                    if comp.len() >= min_area {
+                        small = false;
+                    }
+                }
+                let (x, y) = (i % w, i / w);
+                let mut visit = |j: usize| {
+                    let lj = labels[j];
+                    if lj == l {
+                        if !seen[j] {
+                            seen[j] = true;
+                            stack.push(j);
+                        }
+                    } else if lj != TRANSPARENT {
+                        match neigh.iter_mut().find(|(n, _)| *n == lj) {
+                            Some(e) => e.1 += 1,
+                            None => neigh.push((lj, 1)),
+                        }
+                    }
+                };
+                if x > 0 {
+                    visit(i - 1);
+                }
+                if x + 1 < w {
+                    visit(i + 1);
+                }
+                if y > 0 {
+                    visit(i - w);
+                }
+                if y + 1 < h {
+                    visit(i + w);
+                }
+            }
+            if small && let Some(&(to, _)) = neigh.iter().max_by_key(|(n, c)| (*c, u16::MAX - *n)) {
+                for &i in &comp {
+                    labels[i] = to;
+                }
+            }
+        }
+    }
+
+    fn compare(input: &[u16], w: usize, h: usize, min_area: usize) {
+        let mut expected = input.to_vec();
+        let mut actual = input.to_vec();
+        reference(&mut expected, w, h, min_area);
+        denoise(&mut actual, w, h, min_area);
+        assert_eq!(actual, expected, "{w}x{h}, Noise={min_area}, labels={input:?}");
+    }
+
+    #[test]
+    fn denoise_optimizations_preserve_uniform_and_empty_labels() {
+        for (w, h) in [(0, 0), (0, 5), (5, 0), (1, 1), (1, 127), (127, 1), (64, 128)] {
+            for label in [0, 1, TRANSPARENT] {
+                let labels = vec![label; w * h];
+                for area in [0, 1, 2, w * h, w * h + 1, u32::MAX as usize] {
+                    compare(&labels, w, h, area);
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn denoise_optimizations_match_the_original_for_every_small_mask() {
+        // All 4^6 arrangements exercise diagonal components, transparent gaps,
+        // equal neighbour counts, and regions at both sides of the Noise threshold.
+        for code in 0..4usize.pow(6) {
+            let labels: Vec<u16> = (0..6)
+                .map(|i| match (code >> (i * 2)) & 3 {
+                    3 => TRANSPARENT,
+                    l => l as u16,
+                })
+                .collect();
+            for area in [0, 1, 2, 3, 6, 7, u32::MAX as usize] {
+                compare(&labels, 3, 2, area);
+                compare(&labels, 2, 3, area);
+            }
+        }
+    }
+
+    #[test]
+    fn denoise_optimizations_match_the_original_on_larger_regions() {
+        let (w, h) = (31, 29);
+        for seed in 0..12 {
+            let labels: Vec<u16> = (0..w * h)
+                .map(|i| {
+                    let (x, y) = (i % w, i / w);
+                    match ((x / (seed + 1)) ^ (y / 3) ^ seed) % 5 {
+                        4 => TRANSPARENT,
+                        l => l as u16,
+                    }
+                })
+                .collect();
+            for area in [0, 1, 4, 16, 64, w * h, w * h + 1] {
+                compare(&labels, w, h, area);
+            }
+        }
+    }
