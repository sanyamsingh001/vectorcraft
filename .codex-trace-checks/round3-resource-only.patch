+/// Once an earlier layer exhausted the anchor budget, queued layers do no more
+/// fitting or anchor accounting. The public call will return the same TooComplex.
+#[test]
+fn an_exhausted_anchor_budget_stops_queued_layers() {
+    let q = Quantized { labels: vec![0; 64], palette: vec![[20, 40, 80]] };
+    let params = TraceParams { noise: 1, ..Default::default() };
+    let job = Layers {
+        q: &q,
+        rank: &[0],
+        params: &params,
+        opts: fit::FitOptions { polygon_tol: 0.55, fit_tol: 0.2, corner_angle: 50.0, snap_lines: false },
+        w: 8,
+        h: 8,
+        anchors: AtomicUsize::new(1),
+        max_anchors: 0,
+    };
+    assert!(job.layer(0, 0).is_none());
+    assert_eq!(job.anchors.load(Ordering::Relaxed), 1, "no later path was fitted or counted");
+}
