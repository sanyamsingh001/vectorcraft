+/// At the existing image limit, even a simple many-colour trace must not multiply
+/// full-image contour buffers by the CPU count. These checks allocate no large rasters.
+#[test]
+fn parallel_layers_share_one_maximum_raster_scratch_allowance() {
+    assert_eq!(layer_worker_limit(8192, 8192), 1);
+    assert_eq!(layer_worker_limit(8192, 4096), 2);
+    assert_eq!(layer_worker_limit(4096, 4096), 4);
+    assert_eq!(layer_worker_limit(1, MAX_PIXELS as u32), 1);
+    assert_eq!(layer_worker_limit(MAX_PIXELS as u32, 1), 1);
+    // Includes edge-grid overhead: at most 64 Mi pixels in the most elongated shape.
+    let allowance = 7 * MAX_PIXELS + 2;
+    for (w, h) in [(1, MAX_PIXELS as u32), (MAX_PIXELS as u32, 1), (8192, 8192), (8192, 4096), (4096, 4096), (1, 4096), (64, 64)] {
+        let p = u64::from(w) * u64::from(h);
+        let fixed = 6 * p + u64::from(w) + u64::from(h) + 1;
+        assert!(layer_worker_limit(w, h) as u64 * fixed <= allowance, "{w}x{h}");
+    }
+    // Untrusted dimensions cannot overflow resource-admission arithmetic.
+    assert_eq!(layer_worker_limit(u32::MAX, u32::MAX), 1);
+    assert!(layer_worker_limit(64, 64) >= 16, "small traces retain colour-layer parallelism");
+}
