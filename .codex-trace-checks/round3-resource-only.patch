+/// The dispatcher's actual in-flight work obeys admission, and reducing workers
+/// keeps result order, including when tasks finish at different times.
+#[cfg(not(target_arch = "wasm32"))]
+#[test]
+fn parallel_dispatch_obeys_admission_and_keeps_layer_order() {
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    let items: Vec<usize> = (0..24).collect();
+    for limit in [1, 2] {
+        let active = AtomicUsize::new(0);
+        let peak = AtomicUsize::new(0);
+        let result = parallel_map(&items, limit, |&i| {
+            let now = active.fetch_add(1, Ordering::SeqCst) + 1;
+            peak.fetch_max(now, Ordering::SeqCst);
+            std::thread::sleep(std::time::Duration::from_millis(if i % 3 == 0 { 2 } else { 1 }));
+            active.fetch_sub(1, Ordering::SeqCst);
+            i * i
+        });
+        assert_eq!(result, items.iter().map(|i| i * i).collect::<Vec<_>>());
+        assert!(peak.load(Ordering::SeqCst) <= limit);
+        assert_eq!(active.load(Ordering::SeqCst), 0);
+    }
+}
