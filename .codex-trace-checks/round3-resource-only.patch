+/// Fixed pixel-indexed contour buffers: a bool mask, u32 component labels, and the
+/// (width + 1) × (height + 1) byte edge grid. At P pixels, width + height is at most
+/// P + 1 (a one-pixel-wide image), so one accepted raster needs at most 7P + 2 bytes.
+/// Reuse that existing maximum-raster footprint across workers rather than multiplying
+/// it by the core count. Flood stacks, contour vectors and output are additional memory.
+const MAX_LAYER_SCRATCH_BYTES: u64 = MAX_PIXELS * (std::mem::size_of::<bool>() as u64 + std::mem::size_of::<u32>() as u64 + 2) + 2;
+
+fn layer_worker_limit(width: u32, height: u32) -> usize {
+    let (w, h) = (u64::from(width), u64::from(height));
+    let pixel_bytes = (std::mem::size_of::<bool>() + std::mem::size_of::<u32>()) as u64;
+    let scratch = (w * h).saturating_mul(pixel_bytes).saturating_add((w + 1).saturating_mul(h + 1));
+    usize::try_from(MAX_LAYER_SCRATCH_BYTES.checked_div(scratch).unwrap_or(1).max(1)).unwrap_or(usize::MAX)
+}
