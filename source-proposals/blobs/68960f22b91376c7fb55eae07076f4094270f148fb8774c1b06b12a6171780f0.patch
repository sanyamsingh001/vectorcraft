+#[test]
+fn average_join_menu_and_context_access_follow_the_picked_endpoints() {
+    const COMMAND: &str = "path.averageJoin";
+    const LABEL: &str = "Average and Join…";
+
+    let snapshot = |app: &VectorcraftApp| {
+        let st = app.session.doc().unwrap();
+        let entries = |items: &[vectorcraft_engine::HistoryEntry]| {
+            items.iter().map(|e| (e.label.clone(), e.doc.clone(), e.selection.clone())).collect::<Vec<_>>()
+        };
+        (
+            st.doc.clone(),
+            st.selection.clone(),
+            entries(&st.history.undo),
+            entries(&st.history.redo),
+            st.is_dirty(),
+            app.session.in_interaction(),
+        )
+    };
+
+    for (selection, eligible) in [("empty", false), ("whole_objects", false), ("single_line", false), ("pair", true)] {
+        let mut app = app();
+        app.select_tool("directSelection");
+        let a = NodeId(app.run("shape.line", json!({"x1":20,"y1":100,"x2":100,"y2":100})).unwrap()["id"].as_u64().unwrap());
+        let b = NodeId(app.run("shape.line", json!({"x1":140,"y1":140,"x2":240,"y2":100})).unwrap()["id"].as_u64().unwrap());
+        app.run("object.move", json!({"dx":5,"dy":0})).unwrap();
+        app.run("edit.undo", json!({})).unwrap();
+        match selection {
+            "empty" => app.run("select.none", json!({})).unwrap(),
+            "whole_objects" => app.run("select.set", json!({"ids":[a.0,b.0]})).unwrap(),
+            "single_line" => app.run("select.anchors", json!({"id":a.0,"anchors":[[0,0],[0,1]],"mode":"set"})).unwrap(),
+            "pair" => app.run("select.anchorsMany", json!({"items":[{"id":a.0,"anchors":[[0,1]]},{"id":b.0,"anchors":[[0,0]]}]})).unwrap(),
+            _ => unreachable!(),
+        };
+        app.session.doc_mut().unwrap().mark_saved();
+        let before = snapshot(&app);
+        assert!(!before.3.is_empty(), "fixture retains a usable Redo branch");
+        assert!(!before.4 && !before.5);
+        assert!(app.ui.dialog.is_none());
+
+        // This is the public menu representation; rendered main-menu inspection is separate.
+        let menu = menus::menu_entries(&app);
+        let main: Vec<_> = menu.iter().filter(|e| e.command.as_deref() == Some(COMMAND)).collect();
+        assert_eq!(main.len(), 1, "{selection}: one main-menu entry");
+        assert_eq!(main[0].path, ["Object", "Path"]);
+        assert_eq!(main[0].label, LABEL);
+        assert_eq!(main[0].enabled, eligible, "{selection}");
+
+        // Check the prepared selection before right-click can intentionally retarget an object.
+        let context = menus::context_entries(&app);
+        let entries: Vec<_> = context.iter().filter(|e| e.command.as_deref() == Some(COMMAND)).collect();
+        assert_eq!(snapshot(&app), before);
+        if !eligible {
+            assert!(entries.is_empty(), "{selection}: unavailable context command is omitted");
+            assert!(app.ui.dialog.is_none());
+            continue;
+        }
+        assert_eq!(entries.len(), 1);
+        assert!(entries[0].enabled);
+        assert!(entries[0].path.is_empty());
+        assert_eq!(entries[0].label, LABEL);
+
+        let ctx = egui::Context::default();
+        frame(&mut app, &ctx, vec![]);
+        let path = app.session.doc().unwrap().doc.node(a).unwrap().path_data().unwrap();
+        let endpoint = path.subpaths[0].anchors[1].p;
+        assert_eq!(endpoint, Point::new(100.0, 100.0));
+        let point = screen(&app, endpoint.x, endpoint.y);
+        let texts = click(&mut app, &ctx, point, PointerButton::Secondary);
+        assert_eq!(snapshot(&app), before, "opening the menu at a picked endpoint preserves the pair");
+        let shown: Vec<_> = texts.iter().filter(|(label, _)| label == LABEL).collect();
+        assert_eq!(shown.len(), 1, "one visible entry identifies the click target");
+        let bounds = shown[0].1;
+        assert!(ctx.content_rect().contains_rect(bounds));
+        let target = bounds.center();
+        assert_eq!(ctx.layer_id_at(target).map(|layer| layer.order), Some(egui::Order::Foreground));
+        click(&mut app, &ctx, target, PointerButton::Primary);
+        let dialog = app.ui.dialog.as_ref().expect("the selected context command opens its dialog");
+        assert_eq!(dialog.kind, "averageJoin");
+        assert_eq!(dialog.fields["kind"], json!("corner"));
+        assert_eq!(snapshot(&app), before, "opening Average and Join preserves art, selection, history and saved state");
+    }
+}
