+/// Retire a cancelled column before reading the document or collecting more row changes.
+fn cancel_column_drag(app: &mut VectorcraftApp, ui: &Ui) -> bool {
+    let Some(c) = ui.data(|d| d.get_temp::<ColumnDrag>(key("column"))) else { return false };
+    let owned = app.session.active().is_some_and(|st| {
+        st.uid == c.uid
+            && c.interaction
+                .as_ref()
+                .is_some_and(|owner| st.interaction.as_ref().is_some_and(|it| Weak::ptr_eq(owner, &Arc::downgrade(&it.selection))))
+    });
+    // egui stops the drag before other UI can consume Escape. A tool may also have already
+    // cancelled the interaction: neither case may leave a column to re-preview on motion/Up.
+    let stopped_held = ui.ctx().drag_stopped_id() == Some(c.zone) && ui.input(|i| i.pointer.primary_down());
+    let escape = owned && ui.input_mut(|i| i.consume_key(i.modifiers, egui::Key::Escape));
+    if owned && !escape && !stopped_held {
+        return false;
+    }
+    if owned {
+        if let Err(e) = app.session.cancel_interaction() {
+            app.status(e.to_string());
+        }
+        app.sync_views();
+    }
+    ui.data_mut(|d| d.remove::<ColumnDrag>(key("column")));
+    if app.session.active().is_some_and(|st| st.uid == c.uid) && ui.ctx().is_being_dragged(c.zone) {
+        ui.ctx().stop_dragging();
+    }
+    true
+}
