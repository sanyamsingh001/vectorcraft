+    assert!(crate::menus::enabled(&app, "path.averageJoin"));
+    app.run("path.averageJoin", json!({})).unwrap();
+    assert_eq!(app.session.doc().unwrap().doc.node(id).unwrap().path_data().unwrap().subpaths[0].anchors.len(), 3);
+}
