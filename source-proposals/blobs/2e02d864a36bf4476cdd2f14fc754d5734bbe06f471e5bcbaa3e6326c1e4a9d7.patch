+    key(&ctx, &mut app, egui::Key::J, egui::Modifiers::COMMAND | egui::Modifiers::ALT | egui::Modifiers::SHIFT);
+    let dialog = app.ui.dialog.as_ref().expect("AJ_ROUTE_SHORTCUT: eligible command opens its own dialog");
