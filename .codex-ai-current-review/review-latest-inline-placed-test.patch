+    // Ready for insertion inside crates/doc/src/placed_document.rs's existing tests module.
+    // Exercises public prepared-art behavior without fonts, file IO, an exporter, or large buffers.
+    fn placed_inline_fixture(label: &str, collision: bool) -> (Document, Document, PlacedDocument) {
+        use crate::{CharStyle, InlineArt, TextObject, TextRun};
+        use vectorcraft_color::{Color, Paint};
+        use vectorcraft_geom::{Point, shapes};
+
+        let look = |r, g, b| crate::Appearance::basic(Paint::solid(Color::rgb8(r, g, b)), Paint::None, 0.0);
+        let mut child = Document::new(80.0, 60.0);
+        child.layers.clear();
+        child.symbols.push(Symbol {
+            name: "Dot".into(),
+            art: Arc::new(Node::path(NodeId(900), shapes::rectangle(Rect::new(-10.0, -10.0, 10.0, 10.0)), look(20, 20, 230))),
+        });
+        // App-created symbols keep normalised art; this one was originally a wide 40x10 mark.
+        child.unknown.insert(crate::SYMBOL_SIZES.into(), serde_json::json!({"Dot": [40.0, 10.0]}));
+        let mut text = TextObject::point(Point::new(10.0, 30.0), "", CharStyle::default());
+        text.runs = vec![TextRun::inline(InlineArt::new("Dot"), CharStyle::default())];
+        assert!(child.resolve_text_inline(&mut text));
+        let art = Node::new(NodeId(0), NodeKind::Group { children: vec![Arc::new(Node::new(NodeId(901), NodeKind::Text(Box::new(text))))], clip: false });
+        let p = PlacedDocument { width: 80.0, height: 60.0, ..placed(label) };
+        let blob = ImageBlob::new("application/json", b"original-small-inline-fixture".to_vec());
+        prime(&p, blob.bytes.clone(), (child.clone(), art, Rect::new(0.0, 0.0, 80.0, 60.0)));
+        let mut parent = Document::new(100.0, 80.0);
+        if collision {
+            parent.symbols.push(Symbol {
+                name: "Dot".into(),
+                art: Arc::new(Node::path(NodeId(902), shapes::rectangle(Rect::new(-10.0, -10.0, 10.0, 10.0)), look(230, 20, 20))),
+            });
+            parent.unknown.insert(crate::SYMBOL_SIZES.into(), serde_json::json!({"Dot": [20.0, 20.0]}));
+        }
+        parent.images.insert(p.key.clone(), blob);
+        parent.insert(Some(parent.layers[0].id), 0, Node::new(NodeId(7), NodeKind::PlacedDocument(Box::new(p.clone())))).unwrap();
+        (parent, child, p)
+    }
