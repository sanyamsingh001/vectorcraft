+    #[test]
+    fn placed_inline_art_references_the_source_symbol_with_or_without_a_parent_collision() {
+        for collision in [false, true] {
+            let (parent, child, p) = placed_inline_fixture(&format!("inline-reference-{collision}"), collision);
+            let original = serde_json::to_value(&parent).unwrap();
+            let prepared = parent.with_placed_art();
+            let art = p.art(parent.node(NodeId(7)).unwrap());
+            let mut references = vec![];
+            for root in art {
+                root.walk(&mut |n| {
+                    if let NodeKind::Text(t) = &n.kind {
+                        references.extend(t.runs.iter().filter_map(|r| r.inline.as_ref().map(|a| a.symbol.clone())));
+                    }
+                });
+            }
+            assert_eq!(references.len(), 1, "positive control: the placed art still contains the inline run");
+            let target = prepared.symbols.iter().find(|s| s.name == references[0]).expect("an inline reference must resolve in the prepared document");
+            assert_eq!(
+                serde_json::to_value(&target.art).unwrap(),
+                serde_json::to_value(&child.symbols[0].art).unwrap(),
+                "an inline must show its source's art, including when the parent owns Dot"
+            );
+            assert_eq!(serde_json::to_value(&parent).unwrap(), original, "preparing output leaves the source document intact");
+        }
+    }
+
+    #[test]
+    fn placed_inline_art_keeps_its_sources_natural_symbol_size() {
+        let (parent, child, _) = placed_inline_fixture("inline-natural-size", true);
+        let prepared = parent.with_placed_art();
+        // Identify the imported definition independently of the first test's inline-reference bug.
+        let source_art = serde_json::to_value(&child.symbols[0].art).unwrap();
+        let imported = prepared
+            .symbols
+            .iter()
+            .find(|s| serde_json::to_value(&s.art).unwrap() == source_art)
+            .expect("positive control: the source definition was imported");
+        let expected = child.symbol_art_bounds("Dot").unwrap();
+        assert!((expected.width() - 40.0).abs() < 1e-9 && (expected.height() - 10.0).abs() < 1e-9);
+        assert_eq!(
+            prepared.symbol_art_bounds(&imported.name),
+            Some(expected),
+            "inline layout must keep the source's natural aspect ratio after resource scoping"
+        );
+    }
